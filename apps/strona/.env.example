# Baza danych (Postgres — CMS, cennik, formularze, sesje admina)
DATABASE_URL=postgresql://user:pass@host:5432/detailing_lacko

# JWT sesji administratora panelu (/magazyn) — min. 32 znaki
AUTH_JWT_SECRET=change-me-in-production-min-32-chars

# Seed pierwszego admina (używane tylko przez `pnpm migrate`)
MAGAZYN_ADMIN_EMAIL=
MAGAZYN_ADMIN_PASSWORD=

# Opcjonalna allowlista e-maili admina (CSV). Pusta = brak ograniczenia.
# MAGAZYN_ADMIN_ALLOWLIST=kamil@syntance.com

# Identyfikatory podstron CMS do odczytu w storefront (zgodne z moduly.config.ts)
MODULY_CMS_PAGE_IDS=home

# Publiczny URL witryny (linki w mailach i panelu)
NEXT_PUBLIC_SITE_URL=https://detailing-lacko.pl

# Resend — powiadomienia z formularza kontaktowego i o nowych rezerwacjach.
# Mail o rezerwacji wymaga RESEND_API_KEY + RESEND_FROM + CONTACT_INBOX_EMAIL.
RESEND_API_KEY=
# RESEND_FROM=Detailing Łącko <kontakt@detailing-lacko.pl>
# RESEND_REPLY_TO=kontakt@detailing-lacko.pl
# CONTACT_INBOX_EMAIL=kontakt@detailing-lacko.pl

# Kalendarz Google — dwukierunkowa synchronizacja rezerwacji (konto serwisowe).
# Wydarzenia z kalendarza blokują godziny w widgecie, a rezerwacja tworzy
# w nim wpis „auto w warsztacie". Bez tych trzech zmiennych sync jest wyłączony
# (rezerwacje działają normalnie, tylko bez kalendarza).
#
# Skąd to wziąć:
#  1. console.cloud.google.com → nowy projekt
#  2. APIs & Services → Library → „Google Calendar API" → Enable
#  3. APIs & Services → Credentials → Create credentials → Service account
#  4. wejdź w konto → Keys → Add key → Create new key → JSON (plik pobierze się raz)
#  5. z JSON-a przepisz: client_email → GOOGLE_SA_EMAIL, private_key → GOOGLE_SA_PRIVATE_KEY
#  6. Kalendarz Google → Ustawienia kalendarza → „Udostępnij określonym osobom"
#     → dodaj adres konta serwisowego z uprawnieniem „Wprowadzanie zmian w wydarzeniach"
#  7. w tych samych ustawieniach, sekcja „Integracja kalendarza" → skopiuj
#     „Identyfikator kalendarza" → GOOGLE_CALENDAR_ID
#
# GOOGLE_SA_PRIVATE_KEY: cała zawartość pola private_key w JEDNEJ linii,
# w cudzysłowie, z zachowanymi sekwencjami \n (dokładnie jak w pliku JSON).
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Rate limiting (login, rezerwacje, formularz kontaktowy).
# Na PRODUKCJI wymagane — bez Upstash limiter działa tylko in-memory per
# instancję serverless (loguje błąd konfiguracji). Darmowy plan wystarczy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 — uploady CMS z panelu Magazyn (hero, galeria, metamorfozy, OG).
# Bucket: detailing-lacko-media. Publiczny odczyt: S3_FILE_URL (*.r2.dev).
# Na Vercel ustaw te same klucze w Production + Preview. CORS bucketu musi
# dopuszczać PUT z domeny panelu i localhost (wrangler r2 bucket cors).
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=detailing-lacko-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FILE_URL=https://pub-<hash>.r2.dev
# NEXT_PUBLIC_S3_FILE_URL=https://pub-<hash>.r2.dev

# Analityka client-side (storefront, produkcja)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# Analityka panelu (GA4 + PostHog, server-only)
FEATURE_ANALYTICS_PANEL=1
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com
